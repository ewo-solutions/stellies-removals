---
import '../styles/global.css';
import { PHONE_TEL, WHATSAPP_NUMBER, EMAIL } from '../lib/contact';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  name: 'Stellies Removals',
  image: `${Astro.site}og-image.jpg`,
  telephone: PHONE_TEL,
  email: EMAIL,
  // Removals run within a ~200km radius of Paarl — the GeoCircle covers
  // that generally, with named cities kept for local-search matching on
  // the specific towns the client calls out most often.
  areaServed: [
    {
      '@type': 'GeoCircle',
      geoMidpoint: { '@type': 'GeoCoordinates', latitude: -33.7098, longitude: 18.9623 },
      geoRadius: '200000',
    },
    { '@type': 'City', name: 'Paarl' },
    { '@type': 'City', name: 'Wellington' },
    { '@type': 'City', name: 'Stellenbosch' },
    { '@type': 'City', name: 'Somerset West' },
    { '@type': 'City', name: 'Durbanville' },
    { '@type': 'City', name: 'Cape Town' },
    { '@type': 'City', name: 'Gansbaai' },
    { '@type': 'City', name: 'Swellendam' },
    { '@type': 'City', name: 'St Helena Bay' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Paarl',
    addressRegion: 'Western Cape',
    addressCountry: 'ZA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -33.7098,
    longitude: 18.9623,
  },
  sameAs: [`https://wa.me/${WHATSAPP_NUMBER}`],
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Home removals' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Office relocations' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Packing' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Hoisting' } },
  ],
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Mulish:ital,wght@1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-628744913" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'AW-628744913');
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Fire a provider-agnostic click event on every WhatsApp CTA so
      // whichever analytics tool is wired up later (GTM/GA4/etc.) can
      // report which position on the page converts. No-ops if no
      // analytics layer is present.
      document.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement)?.closest<HTMLAnchorElement>('[data-wa-source]');
        if (!target) return;
        const source = target.getAttribute('data-wa-source');
        const w = window as unknown as { dataLayer?: unknown[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ event: 'whatsapp_click', wa_source: source });
      });
    </script>

    <script>
      // Fade + rise each [data-reveal] element into place as it enters the
      // viewport. Reduced-motion users get the CSS fallback (always
      // visible, see global.css) so the observer just no-ops for them.
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (revealTargets.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
        );

        revealTargets.forEach((el) => observer.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

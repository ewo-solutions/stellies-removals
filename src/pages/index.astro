---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import Steps from '../components/Steps.astro';
import WhatsAppPanel from '../components/WhatsAppPanel.astro';
import Testimonial from '../components/Testimonial.astro';
import ClosingBanner from '../components/ClosingBanner.astro';
import Footer from '../components/Footer.astro';
import MobileWhatsAppBar from '../components/MobileWhatsAppBar.astro';
import PreloadCurtain from '../components/PreloadCurtain.astro';
---

<Layout
  title="Furniture Removals in Paarl | Stellies Removals"
  description="Stellies Removals runs a dedicated crew in Paarl, covering home and office removals, packing and hoisting within a 200km radius — Wellington, Stellenbosch, Somerset West, Cape Town, Gansbaai, Swellendam and St Helena Bay. Get a free quote on WhatsApp."
>
  <PreloadCurtain />
  <Header />
  <main>
    <Hero />
    <TrustBar />
    <Services />
    <Steps />
    <WhatsAppPanel />
    <Testimonial />
    <ClosingBanner />
  </main>
  <Footer />
  <MobileWhatsAppBar />
</Layout>

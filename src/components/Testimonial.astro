---
import { Image } from 'astro:assets';
import teamImage from '../assets/images/team.jpg';
---

<section class="testimonial">
  <div class="container testimonial__grid">
    <div class="testimonial__image">
      <Image src={teamImage} alt="The Stellies Removals crew" width={700} height={560} />
    </div>
    <div class="testimonial__copy">
      <div class="testimonial__stars" aria-hidden="true">★★★★★</div>
      <blockquote class="testimonial__quote">
        &ldquo;They were on time, professional, friendly and effective as they ensured that our furniture were moved
        safely to our new residence. I highly recommend them!&rdquo;
      </blockquote>
      <div class="testimonial__attribution">— Vicky Van Deventer</div>
    </div>
  </div>
</section>

<style>
  .testimonial {
    border-bottom: var(--rule);
  }

  .testimonial__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.1fr;
  }

  .testimonial__image {
    position: relative;
    min-width: 0;
    min-height: 420px;
    border-right: var(--rule);
  }
  .testimonial__image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial__copy {
    padding: 72px 0 72px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  .testimonial__stars {
    color: var(--maroon);
    font-size: 20px;
    letter-spacing: 0.1em;
  }

  .testimonial__quote {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 600;
    text-wrap: pretty;
  }

  .testimonial__attribution {
    font-size: 16px;
    font-weight: 700;
    color: var(--body-grey);
  }

  @media (max-width: 900px) {
    .testimonial__grid {
      grid-template-columns: 1fr;
    }
    .testimonial__image {
      border-right: none;
      border-bottom: var(--rule);
      min-height: 280px;
    }
    .testimonial__copy {
      padding: 40px 20px;
    }
    .testimonial__quote {
      font-size: 24px;
    }
  }
</style>

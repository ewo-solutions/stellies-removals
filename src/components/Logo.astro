---
// Stellies Removals wordmark, as supplied by the client (Sep 2026) —
// replaces the earlier hand-recreated SVG approximation the design handoff
// flagged as a stand-in ("the wordmark font is a close match, not the
// original brand typeface... if the client supplies the real logo,
// substitute it"). Cropped from their reference image down to just the
// mark + wordmark (no phone-number lockup).
//
// This is a plain white-background raster. It sits directly on white/light
// surfaces (the header) with no extra work. On a dark surface — the footer,
// the preload curtain — wrap it in a white "plate" (see those components):
// no reversed/light colorway of the real logo has been supplied, so
// inventing one isn't an option; a flush white rectangle behind it is the
// flat, no-gradient way to keep it legible without guessing at colors.
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo-wordmark.png';

interface Props {
  width?: number;
  class?: string;
}

const { width = 274, class: className } = Astro.props;
const aspect = logoSrc.width / logoSrc.height;
const height = Math.round(width / aspect);
---

<Image src={logoSrc} alt="Stellies Removals" width={width} height={height} class={className} />

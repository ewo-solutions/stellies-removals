---
// Fixed bottom-of-viewport CTA bar for mobile — the whole page pushes
// toward one action, and on a small screen the header CTA scrolls out of
// reach fastest. Hidden on desktop.
import SendIcon from './icons/SendIcon.astro';
---

<a href="#enquiry" class="mobile-cta-bar" data-cta-source="mobile-sticky-bar">
  <SendIcon size={20} />
  Get a Free Quote
</a>

<style>
  .mobile-cta-bar {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-cta-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      background: var(--primary);
      color: var(--white);
      border-top: var(--rule);
      padding: 14px 20px;
      padding-bottom: max(14px, env(safe-area-inset-bottom));
      font-family: var(--font-heading);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    .mobile-cta-bar:hover {
      background: var(--primary-dark);
      color: var(--white);
    }

    /* Keep the fixed bar from covering the last section's content. */
    :global(body) {
      padding-bottom: 60px;
    }
  }
</style>

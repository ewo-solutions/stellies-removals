---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { PHONE_TEL, PHONE_INTL_DISPLAY, waLink, WA_MESSAGE_DEFAULT } from '../lib/contact';
---

<section class="closing">
  <div class="container closing__grid">
    <div data-reveal>
      <h2 class="closing__heading">Moving in Paarl? Let&rsquo;s talk.</h2>
      <p class="closing__lead">
        Stellies Removals brings years of Boland experience to every relocation — residential or office, packed and
        placed with care.
      </p>
    </div>
    <div class="closing__actions" data-reveal style="--reveal-delay: 120ms">
      <a
        href={waLink(WA_MESSAGE_DEFAULT)}
        target="_blank"
        rel="noopener"
        class="btn btn--white"
        data-wa-source="banner"
      >
        <WhatsAppIcon size={22} />
        WhatsApp for a quote
      </a>
      <a href={`tel:${PHONE_TEL}`} class="btn btn--outline-white">{PHONE_INTL_DISPLAY}</a>
    </div>
  </div>
</section>

<style>
  .closing {
    background: var(--maroon);
    color: var(--white);
  }

  .closing__grid {
    padding: 80px 32px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .closing__heading {
    margin: 0 0 18px;
    font-family: var(--font-heading);
    font-size: 52px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .closing__lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    max-width: 34em;
    color: var(--banner-tint);
  }

  .closing__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .closing__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 20px;
    }
    .closing__heading {
      font-size: 36px;
    }
    .closing__actions {
      width: 100%;
    }
    .closing__actions :global(.btn) {
      justify-content: center;
      width: 100%;
    }
  }
</style>

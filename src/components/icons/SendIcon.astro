  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="m22 2-7 20-4-9-9-4Z"></path>
  <path d="M22 2 11 13"></path>
</svg>
